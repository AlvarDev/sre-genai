{
  "displayName": "GenAI Token Consumption Dashboard",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Daily Token History",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_token_type) (increase(workload_googleapis_com:gen_ai_client_token_usage_sum{monitored_resource=\"generic_task\"}[1d])) or sum by (gen_ai_request_model, gen_ai_token_type) (increase(workload_googleapis_com:gen_ai_client_token_usage_sum{monitored_resource=\"generic_node\"}[1d]))"
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": {
              "label": "Tokens / Day",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Token Consumption Rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(workload_googleapis_com:gen_ai_client_token_usage_sum{monitored_resource=\"generic_task\"}[5m]))"
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": {
              "label": "Tokens / Sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 5,
        "height": 4,
        "widget": {
          "title": "Guardrail Violations",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (violation_type) (increase(workload_googleapis_com:google_store_guardrail_violations{monitored_resource=\"generic_task\"}[1h]))"
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": {
              "label": "Violations / Hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 5,
        "yPos": 4,
        "width": 2,
        "height": 4,
        "widget": {
          "title": "Total Token Consumed (24h)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(increase(workload_googleapis_com:gen_ai_client_token_usage_sum{monitored_resource=\"generic_task\"}[24h]))"
            }
          }
        }
      },
      {
        "xPos": 7,
        "yPos": 4,
        "width": 5,
        "height": 4,
        "widget": {
          "title": "Average Inference Latency",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model) (rate(workload_googleapis_com:gen_ai_client_operation_duration_sum{monitored_resource=\"generic_task\"}[5m])) / sum by (gen_ai_request_model) (rate(workload_googleapis_com:gen_ai_client_operation_duration_count{monitored_resource=\"generic_task\"}[5m]))"
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": {
              "label": "Latency (Seconds)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool Calls per Turn (Agent Loop Detection)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_agent_name) (rate(workload_googleapis_com:gen_ai_invoke_agent_tool_calls_sum{monitored_resource=\"generic_task\"}[5m])) / sum by (gen_ai_agent_name) (rate(workload_googleapis_com:gen_ai_invoke_agent_tool_calls_count{monitored_resource=\"generic_task\"}[5m]))"
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": {
              "label": "Avg Tool Calls / Turn",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool Execution Duration",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_tool_name) (rate(workload_googleapis_com:gen_ai_execute_tool_duration_sum{monitored_resource=\"generic_task\"}[5m])) / sum by (gen_ai_tool_name) (rate(workload_googleapis_com:gen_ai_execute_tool_duration_count{monitored_resource=\"generic_task\"}[5m]))"
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": {
              "label": "Latency (Seconds)",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
